<?xml version="1.0" encoding="utf-8"?>
<!-- Aucune autorisation pour l'instant : l'appli montre l'interface, avec des valeurs simulées. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/nom_appli"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.SensorMaps">

        <!-- La rotation ne recharge pas l'écran ; le passage clair ou sombre, si. -->
        <activity
            android:name=".EcranPrincipal"
            android:exported="true"
            android:theme="@style/Theme.SensorMaps.Demarrage"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
